# Deployed Product Service (CDK API Gateway). No trailing slash.
# Example: https://abc123.execute-api.eu-central-1.amazonaws.com/prod
VITE_API_PRODUCT=

# Deployed Import Service (CDK API Gateway). No trailing slash.
# Example: https://xyz789.execute-api.eu-central-1.amazonaws.com/prod
VITE_API_IMPORT=

# Optional: single base for every service (overrides individual URLs when set)
# VITE_API_BASE=
